# Chromium v151 Stealth - GN build args (out/StealthRelease/args.gn)
# Optimized production build: small, fast, no Google telemetry.

is_official_build = true
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
chrome_pgo_phase = 0

# Strip Google reporting / API baked-in creds.
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# SafeBrowsing: keep the code compiled at the DESKTOP level so the
# safe_browsing GN targets that chrome's graph references still resolve.
# mode meaning (from //components/safe_browsing/buildflags.gni): 0=off,
# 1=FULL desktop, 2=mobile/Android (external API). The platform default is
# 1 for !is_android and 2 for is_android.
# NOTE: mode 0 breaks `gn gen` -- content targets (file_type_policies,
# client_side_detection) get compiled out -> "Unresolved dependencies".
# mode 2 ALSO breaks it on Windows: the //components:components_unittests
# graph then pulls //components/safe_browsing/android:native_java_unittests_java
# which imports android abi.gni -> assert(is_android...) fails. So for a
# Windows x64 build the correct value is 1 (full desktop). Telemetry stays
# inert anyway because google_api_key is blank (Safe Browsing cannot phone
# home without an API key), and it can be disabled at runtime via prefs/policy
# in the CyberPunch wrapper.
safe_browsing_mode = 1

# Do not stop the build on warnings (patched files may warn).
treat_warnings_as_errors = false

# ---------------------------------------------------------------------------
# TARGET OS = WINDOWS x64 (chốt: tool CyberPunch cần chrome.exe).
# Built on a windows-2022 GitHub runner (VS 2022 + Windows SDK preinstalled).
target_os  = "win"
target_cpu = "x64"
# ---------------------------------------------------------------------------
